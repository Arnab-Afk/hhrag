[Unit]
Description=HH RAG Goa voice API
After=network.target

[Service]
User=swdc-kjsse
Group=swdc-kjsse
WorkingDirectory=/vm-storage/hhrag/src
EnvironmentFile=/vm-storage/hhrag/src/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/vm-storage/hhrag/venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 7860
Restart=always
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
