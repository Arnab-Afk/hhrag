# Sarvam STT — https://dashboard.sarvam.ai
SARVAM_API_KEY=

# Anthropic generation (preferred) — https://console.anthropic.com
# Haiku is the fast model. Leave both LLM keys empty for extractive mode.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Groq generation fallback — https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Index + embedding
INDEX_DIR=indexes
EMBEDDING_MODEL=intfloat/multilingual-e5-small
LANGUAGES=hi,en

# Retrieval
RETRIEVE_TOP_K=20
RRF_K=60
MIN_RETRIEVAL_SCORE=0.012
ENABLE_RERANK=false

# Guardrails
GROUNDING_MIN_OVERLAP=0.18
MAX_AUDIO_SECONDS=30

# Server
HOST=0.0.0.0
PORT=7860
