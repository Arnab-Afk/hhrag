# Sarvam STT — https://dashboard.sarvam.ai
SARVAM_API_KEY=

# Groq generation — https://console.groq.com
# Leave empty to run extractive mode (no LLM; retrieval-only answers).
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Index + embedding
INDEX_DIR=indexes
EMBEDDING_MODEL=intfloat/multilingual-e5-small
LANGUAGES=hi,en

# Retrieval
RETRIEVE_TOP_K=20
RRF_K=60
MIN_RETRIEVAL_SCORE=0.012
ENABLE_RERANK=false

# Guardrails
GROUNDING_MIN_OVERLAP=0.18
MAX_AUDIO_SECONDS=30

# Server
HOST=0.0.0.0
PORT=7860
